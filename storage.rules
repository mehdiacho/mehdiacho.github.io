rules_version = '2';

/**
 * mehdi-00 — cover art and card media.
 *
 * Read is public because these files are rendered on a public site. Write is
 * Mehdi only, and constrained: an upload path that accepts arbitrary content
 * types and unbounded sizes is a free file host attached to a public domain.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'mehdiacho@gmail.com';
    }

    match /covers/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp|svg\\+xml|gif)');
      allow delete: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
